{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tracking-game",
  "main": "src/index.js",
  "compatibility_date": "2024-10-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./build",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "COOKIES_KV",
      "id": "cookies_kv"
    }
  ]
}
